{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "pin_code",
    "object_type"
  ],
  "properties": {
    "object_type": {
      "const": "PASSBOLT_SECRET_DATA"
    },
    "pin_code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 12,
      "pattern": "^\\d+$"
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 50000
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
